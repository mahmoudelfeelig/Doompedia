{
  "version": 1,
  "id": "doompedia",
  "source": {
    "repository": "mahmoudelfeelig/Doompedia",
    "default_branch": "main",
    "required_workflows": ["doompedia-ci"]
  },
  "registry": {
    "host": "registry.elfeel.me",
    "image_namespace": "apps/doompedia",
    "release_repository": "releases/doompedia"
  },
  "release": {
    "strategy": "source-build",
    "components": [
      {
        "name": "web",
        "context": ".",
        "dockerfile": "deploy/Dockerfile"
      }
    ]
  }
}
